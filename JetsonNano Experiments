from adafruit_servokit import ServoKit
import time
mykit = ServoKit(channels=16 )

while True : 
    for i in range(0,180,1):
        mykit.servo[1].angle= i
        mykit.servo[0].angle= i
        time.sleep(.01)
    for i in range(180,0,1):
        mykit.servo[1].angle= i
        mykit.servo[0].angle= 180
        time.sleep(.005)
    for i in range(0,180,1):
        mykit.servo[1].angle= i
        mykit.servo[0].angle= 180
        time.sleep(.01)

    for i in range(180,0,-1):
        mykit.servo[0].angle= i
        mykit.servo[1].angle= i
        time.sleep(.01)
    for i in range(0,180,1):
        mykit.servo[1].angle= i
        time.sleep(.005)

